# Copy to .env.production locally, fill privately, then import into Coolify.
# This example contains no working credentials. Real .env.production is ignored by Git.
# All variables below are runtime-only, never build-time or VITE_*.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
APP_URL=https://your-domain.example
APP_TIMEZONE=Europe/Moscow
TRUST_PROXY_HOPS=1
RUN_SCHEDULER=true

# External PostgreSQL 17. Both URLs refer to the SAME server/database.
# DATABASE_URL: separate restricted application login and its password.
# MIGRATION_DATABASE_URL: administrative login for first schema creation/maintenance.
# Fill both URLs privately; encode special characters in usernames/passwords.
# No sslmode/sslcert/etc in URLs: TLS is configured by DATABASE_TLS.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_TLS=verify-full

# First launch ONLY: verify these match the administrative connection exactly.
MIGRATION_EXPECTED_DATABASE=
MIGRATION_EXPECTED_ROLE=
INITIALIZE_EMPTY_DATABASE=true

# First launch creates tables and defaults only. No demo data or local owner copied.
# After first successful initialization and owner setup, switch INITIALIZE_EMPTY_DATABASE=false.
# Later schema changes use controlled migrations with a verified backup.
PRODUCTION_MIGRATIONS_ALLOWED=false
MIGRATION_BACKUP_FILE=
BACKUP_DIRECTORY=/backups

# Optional: fill privately when connecting your bot; never exposed in frontend.
TELEGRAM_BOT_TOKEN=
