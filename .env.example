# Generate the local .env with: npm run env:init
# Production values must be set in Coolify, not committed.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_URL=http://127.0.0.1:5173
APP_TIMEZONE=Europe/Moscow

# Private values are generated locally and never displayed.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=55438
DATABASE_URL=
MIGRATION_DATABASE_URL=
RUNTIME_DATABASE_ROLE=
DATABASE_TLS=disabled

# Add only when configuring Telegram in stage 9.
TELEGRAM_BOT_TOKEN=
TRUST_PROXY_HOPS=0
RUN_SCHEDULER=true

# Production release gates (set privately in Coolify maintenance environment).
PRODUCTION_MIGRATIONS_ALLOWED=false
MIGRATION_EXPECTED_DATABASE=
MIGRATION_EXPECTED_ROLE=
MIGRATION_BACKUP_FILE=
BACKUP_DIRECTORY=backups
