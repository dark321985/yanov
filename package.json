{
  "name": "skladno",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "env:init": "node scripts/init-env.mjs",
    "db:up": "node scripts/local-db.mjs up",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:check": "tsx scripts/check-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:init:production": "tsx scripts/init-production.ts",
    "db:schema": "tsx scripts/export-schema.ts",
    "test:deployment": "tsx --test tests/deployment.test.ts",
    "test:bootstrap": "tsx --test tests/bootstrap-start.test.ts",
    "db:runtime": "tsx scripts/runtime-role.ts",
    "owner:setup": "tsx scripts/owner.ts setup",
    "owner:reset": "tsx scripts/owner.ts reset",
    "test:domain": "tsx --test tests/domain.test.ts",
    "test:password": "tsx --test tests/password-input.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:backup": "tsx --test tests/backup.test.ts",
    "test:browser": "tsx --test tests/browser.test.ts",
    "test:demo-finance": "tsx --test tests/demo-finance.test.ts",
    "test:production": "tsx --test tests/production.test.ts",
    "db:backup": "tsx scripts/backup.ts",
    "heroui:docs": "node scripts/heroui-mcp.mjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json --noEmit",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "test:foundation": "tsx --test tests/foundation.test.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "lucide-react": "^1.71.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.1.17",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
